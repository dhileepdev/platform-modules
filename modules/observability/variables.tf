variable "namespace" {
  description = "Namespace for the monitoring stack."
  type        = string
  default     = "monitoring"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,20}$", var.namespace))
    error_message = "namespace must match ^[a-z][a-z0-9-]{1,20}$."
  }
}

variable "prometheus_retention" {
  description = "How long Prometheus keeps samples."
  type        = string
  default     = "6h"

  validation {
    condition     = can(regex("^[0-9]+[dhm]$", var.prometheus_retention))
    error_message = "prometheus_retention must look like 6h, 7d or 30m."
  }
}

variable "grafana_admin_password" {
  description = "Grafana admin password. Generated by the chart when null."
  type        = string
  sensitive   = true
  default     = null
}

variable "alert_webhook_url" {
  description = "Optional Alertmanager webhook URL."
  type        = string
  default     = null
}

variable "slos" {
  description = "SLOs to render as recording and alerting rules."
  type = list(object({
    name   = string
    target = number
    window = string
  }))
  default = []

  validation {
    condition     = alltrue([for slo in var.slos : can(regex("^[a-z][a-z0-9-]{1,30}$", slo.name))])
    error_message = "Every SLO name must match ^[a-z][a-z0-9-]{1,30}$."
  }

  validation {
    condition     = alltrue([for slo in var.slos : slo.target > 0 && slo.target < 1])
    error_message = "Every SLO target must be greater than 0 and less than 1."
  }

  validation {
    condition     = alltrue([for slo in var.slos : contains(["7d", "28d", "30d"], slo.window)])
    error_message = "Every SLO window must be one of 7d, 28d or 30d."
  }

  validation {
    condition     = length(distinct([for slo in var.slos : slo.name])) == length(var.slos)
    error_message = "SLO names must be unique."
  }
}
